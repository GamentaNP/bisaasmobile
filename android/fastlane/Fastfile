# Fastlane for BiSaaS CivilCal — Android
# Usage: `fastlane android beta` (internal) or `fastlane android prod` (Play Store)
# Requires: `ANDROID_KEYSTORE_BASE64`, `PLAY_SERVICE_JSON` in CI secrets; `dart_defines/production.json` for ENV=prod.

default_platform(:android)

platform :android do
  desc "Build and push to Play Internal (beta)"
  lane :beta do
    gradle(task: "clean")
    # APP_VERSION feeds the server's X-App-Version minimum-version gate (W3.6);
    # fall back to the pubspec version when CI does not pass one.
    version = ENV["APP_VERSION"] || sh("grep -E '^version:' ../pubspec.yaml | awk '{print $2}' | cut -d '+' -f1").strip
    # --obfuscate + --split-debug-info (W2.1): Dart symbol obfuscation on every
    # release build; symbols stay in build/symbols and must never leave the
    # build machine except as a private CI artifact.
    sh("flutter build appbundle --release --dart-define=ENV=prod --dart-define=APP_VERSION=#{version} --dart-define-from-file=../dart_defines/production.json --obfuscate --split-debug-info=../build/symbols/android")
    supply(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload pre-built AAB to Play Internal (skips Flutter build)"
  lane :upload_only do
    supply(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote internal -> production ( staged rollout 10% )"
  lane :prod do
    supply(
      track: "production",
      rollout: "0.1",
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Bump versionCode / versionName from pubspec"
  lane :bump do
    # version is source of truth in pubspec.yaml: `version: 1.0.0+1` -> versionName 1.0.0, versionCode 1
    # This lane only validates; bump pubspec manually per `MOBILE_API_INTEGRATION_GUIDE.md` deprecation policy.
    sh("flutter --version")
  end
end