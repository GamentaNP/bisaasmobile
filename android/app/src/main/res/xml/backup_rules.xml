<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy backup rules for API 28–30 (`android:fullBackupContent`).

  `android:allowBackup="false"` disables backup on these API levels, but the
  rules are declared as well so that a build with the flag flipped — or an
  OEM that ignores it — still refuses to carry the bearer PAT out of
  flutter_secure_storage or the cached quiz answers on disk.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
