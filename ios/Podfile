# CocoaPods for the CivilCal iOS app.
#
# This file is committed on purpose. Without it, every build machine
# (CI included) resolves the plugin pods from scratch, and two machines
# can end up with different pod versions for the same commit — the classic
# "works on my machine" release. `Podfile.lock` pins the resolved graph;
# it is generated by `pod install` on macOS and must be committed together
# with this file.
#
# `ios/Podfile.lock` is NOT committed yet because CocoaPods only runs on
# macOS and this repository is developed on Windows. Generate it once on a
# Mac with:
#
#     flutter pub get
#     (cd ios && pod install)
#
# and commit the result. See `docs/release_checklist.md`.

# The deployment target matches `IPHONEOS_DEPLOYMENT_TARGET` in
# `ios/Runner.xcodeproj/project.pbxproj` (15.0). The two must agree:
# CocoaPods raises every pod to the Podfile's target, but Xcode raises the
# *app* to the project's target, so a mismatch silently builds some pods
# against an older SDK than the app.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously, which slows the
# Flutter build down on every invocation.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # `freerasp` and the Firebase pods both declare an iOS deployment
    # target lower than the app's, and Xcode then refuses to embed a
    # framework built for an older OS. Raising every pod to the app's own
    # target is what `flutter build ipa` does for a fresh project, so keep
    # the two in step.
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
