# Fastlane for BiSaaS CivilCal — iOS (run on a macOS machine with Xcode 16+).
# Usage: `fastlane ios beta` (TestFlight) or `fastlane ios prod` (App Store).
# Requires: `MATCH_PASSWORD`, `APP_STORE_CONNECT_API_KEY_JSON` (or apple_id env),
# `ios/Runner/GoogleService-Info.plist` present, `dart_defines/production.json`.

default_platform(:ios)

platform :ios do
  desc "Sync signing certs/profiles via Match"
  lane :certs do
    match(type: "appstore", readonly: true)
  end

  desc "Build and upload a TestFlight beta"
  lane :beta do
    certs
    # APP_VERSION feeds the server's X-App-Version minimum-version gate (W3.6).
    version = ENV["APP_VERSION"] || sh("grep -E '^version:' ../pubspec.yaml | awk '{print $2}' | cut -d '+' -f1").strip
    # --obfuscate + --split-debug-info (W2.1): Dart symbol obfuscation on every
    # release build; symbols stay in build/symbols and must never leave the
    # build machine except as a private CI artifact.
    sh("flutter build ipa --release --dart-define=ENV=prod --dart-define=APP_VERSION=#{version} --dart-define-from-file=dart_defines/production.json --obfuscate --split-debug-info=../build/symbols/ios")
    upload_to_testflight(
      ipa: "../build/ios/ipa/CivilCal.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Submit metadata + build to App Store Review"
  lane :prod do
    certs
    version = ENV["APP_VERSION"] || sh("grep -E '^version:' ../pubspec.yaml | awk '{print $2}' | cut -d '+' -f1").strip
    sh("flutter build ipa --release --dart-define=ENV=prod --dart-define=APP_VERSION=#{version} --dart-define-from-file=dart_defines/production.json --obfuscate --split-debug-info=../build/symbols/ios")
    deliver(
      ipa: "../build/ios/ipa/CivilCal.ipa",
      force: true,
      skip_screenshots: false,
      skip_metadata: false
    )
  end
end
