	<!-- Security identifiers (deployment verification).

	     ITSAppUsesNonExemptEncryption=false declares that the app does not use
	     exempt encryption, so the store does not gate every build on an
	     export-compliance questionnaire. The app talks to one HTTPS API and
	     stores its bearer PAT in the iOS keychain.

	     UIFileSharingEnabled / LSSupportsOpeningDocumentsInPlace stay off: the
	     app has no user documents to expose through the Files app, and
	     leaving them on would publish the local cache directory to anyone
	     with the device.

	     NSAppTransportSecurity is declared explicitly with no exceptions so
	     the ATS posture is visible in the plist rather than implied by its
	     absence. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIFileSharingEnabled</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<!-- Rewarded ads (Google AdMob / google_mobile_ads).

	     GADApplicationIdentifier is an Xcode build setting, not a literal:
	     the app ID is supplied at build time via ADMOB_APP_ID_IOS. An empty
	     value simply leaves the SDK uninitialised — the Dart service checks
	     the same dart-define before it ever asks the plugin to do anything.

	     SKAdNetwork identifiers below are Google's published, public network
	     identifiers (developers.google.com/admob/ios/ios14); they are NOT ad
	     unit IDs or app IDs and carry no account-specific secret.

	     No NSUserTrackingUsageDescription and no ATT prompt are added: the
	     app does not request IDFA, and ATS above stays strict. -->
	<key>GADApplicationIdentifier</key>
	<string>$(ADMOB_APP_ID_IOS)</string>
