# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Gradle's per-module build output (reports, intermediates).
/android/build/
/android/app/build/

# Widget Preview related
.widget_preview/

# Firebase native config — never commit
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
ios/firebase_app_id_file.json

# Release signing — never commit
android/key.properties
android/app/upload-keystore.jks
android/app/*.jks
android/app/*.keystore
*.jks
*.keystore

# Google Play service-account key for `fastlane supply` — never commit.
# The Play Appfile points at `android/play-service.json`; CI materialises the
# file from the PLAY_SERVICE_JSON_BASE64 secret before the lane runs.
android/play-service.json
android/fastlane/play-service.json

# Env & secrets — never commit
.env
.env.*
!.env.example

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# Coverage
coverage/
lcov.info

.mimosa/
.playwright-mcp/

# Node tooling (accidental npm installs at repo root)
node_modules/
